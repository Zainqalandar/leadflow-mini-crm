PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@leadflow.local
ADMIN_PASSWORD=replace-with-a-strong-local-password
# Optional in production: use a bcrypt hash instead of ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
FRONTEND_URL=http://localhost:5173
ANGULAR_URL=http://localhost:4200
API_SECRET=replace-with-a-local-api-secret
