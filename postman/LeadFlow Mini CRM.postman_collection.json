{
  "info": {
    "name": "LeadFlow Mini CRM API",
    "description": "Import this collection into Postman. Update the three credential variables once, run Login first, then use the requests in order. The token and leadId are saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@leadflow.local",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "replace-with-a-strong-local-password",
      "type": "string"
    },
    {
      "key": "apiSecret",
      "value": "replace-with-a-local-api-secret",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health check succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Login - saves JWT automatically",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. WordPress Integration",
      "item": [
        {
          "name": "Receive WordPress Lead - saves leadId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-secret",
                "value": "{{apiSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"WordPress Visitor\",\n  \"email\": \"wordpress+{{$timestamp}}@example.com\",\n  \"phone\": \"+92 300 1234567\",\n  \"service\": \"Web Development\",\n  \"budgetRange\": \"10k or above\",\n  \"message\": \"We need a responsive company website with lead generation and CMS support.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/integrations/wordpress/leads"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WordPress lead accepted', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.lead && data.lead._id) {",
                  "    pm.collectionVariables.set('leadId', data.lead._id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Leads - CRUD",
      "item": [
        {
          "name": "Create Dashboard Lead - saves leadId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dashboard Visitor\",\n  \"email\": \"dashboard+{{$timestamp}}@example.com\",\n  \"phone\": \"+92 301 7654321\",\n  \"service\": \"E-commerce Development\",\n  \"budgetRange\": \"10k or above\",\n  \"message\": \"We need an online store with product management, checkout, and a responsive dashboard.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard lead created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.lead && data.lead._id) {",
                  "    pm.collectionVariables.set('leadId', data.lead._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/leads?page=1&limit=20"
          }
        },
        {
          "name": "Search Leads - status and text query",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/leads?status=New&q=website&page=1&limit=20"
          }
        },
        {
          "name": "Get Lead by leadId",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          }
        },
        {
          "name": "Update Lead by leadId",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Dashboard Lead\",\n  \"email\": \"updated+{{$timestamp}}@example.com\",\n  \"phone\": \"+92 301 7654321\",\n  \"service\": \"E-commerce Development\",\n  \"budgetRange\": \"10k or above\",\n  \"message\": \"Updated: the project includes checkout, product management, analytics, and a responsive dashboard.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          }
        },
        {
          "name": "Change Lead Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Contacted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/leads/{{leadId}}/status"
          }
        },
        {
          "name": "Delete Lead by leadId",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          }
        }
      ]
    },
    {
      "name": "5. Dashboard and Angular Insights",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/leads/stats"
          }
        },
        {
          "name": "Angular Lead Insights",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/leads/insights"
          }
        }
      ]
    }
  ]
}
